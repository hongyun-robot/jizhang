# 本地开发配置：复制为 .env（已被 git 忽略）
# compose 做 ${...} 插值时读取本文件；容器内 env 由 docker-compose.yml 显式给出

# ---- 本机开发（go run 直连 compose 容器）----
# 本机 WSL 已占用 3306/6379，compose 容器映射到 3307/6380
# DB_PORT 是宿主侧端口，compose 与 go run 共用同一值（改一处两处都变，别只改一半）
DB_PORT=3307
REDIS_ADDR=127.0.0.1:6380
# REDIS_PORT 与 REDIS_ADDR 里的端口必须一致（compose 插值读这个变量）
REDIS_PORT=6380
# 宿主侧监听地址。默认 127.0.0.1：数据库/Redis 不暴露公网（安全组挡是运气，不是设计）
DB_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# ---- 数据库口令（mysql 与 api 容器共用同一来源，生产必须改）----
DB_PASSWORD=devpass
DB_NAME=jizhang

# ---- 管理员种子（首次启动幂等创建）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- JWT 与会话（生产必须改 JWT_SECRET）----
JWT_SECRET=dev-secret-change-me
ACCESS_TTL_MIN=30
REFRESH_TTL_HOURS=720
# HTTPS 部署时设 true（refresh cookie 打 Secure 标记）
COOKIE_SECURE=false
# refresh cookie 的 Path。必须与浏览器实际访问路径一致，否则刷新请求不带 cookie。
# 根路径部署（独立子域名）保持默认；挂子路径时改成 /jizhang/api/v1/auth。
COOKIE_PATH=/api/v1/auth

# ---- 跨域白名单（nginx 同源部署时保持默认即可）----
CORS_ORIGINS=http://localhost:5600

# ---- 服务器全栈部署（docker compose --profile app）----
# web 容器对外端口与监听地址：
# 本地开发保持默认 0.0.0.0:80 直连；
# 服务器上由宿主 nginx 终止 TLS 再反代 → 必须设 HTTP_BIND=127.0.0.1 只监听回环，
# 否则容器端口直接暴露公网（与 DB_BIND/REDIS_BIND 同理）
HTTP_PORT=80
# HTTP_BIND=127.0.0.1

# 服务端基金行情配置；密钥不发送给浏览器
FUYAO_API_KEY=

# 可选的苏银理财公开净值采集器；民生 FBAE68020E 使用独立 HTTP 源，无需此配置
# 此配置尚不代表产品已通过自动采集准入
# 本机独立运行采集器时可用 http://127.0.0.1:8091，密钥与采集器进程保持一致
WEALTH_COLLECTOR_URL=
WEALTH_COLLECTOR_KEY=
# 生产选择采集 overlay 时在服务器私有 .env 设置（本机普通开发无需启用）
# COMPOSE_FILE=docker-compose.yml:docker-compose.wealth.yml
